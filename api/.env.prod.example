# API production environment (example)
# HTTP server
PORT=3000

# JWT secret used to sign tokens (change in real .env.prod)
JWT_SECRET=change_me_in_production

# CORS allowlist (CSV)
# Origins autorisés pour l'API en PROD
# Exemple local via nginx : http://localhost
# Exemple domaine prod : https://www.votre-domaine.com
# Exemple domaine dev : http://localhost:5173
CORS_ORIGINS=http://localhost,https://www.votre-domaine.com
